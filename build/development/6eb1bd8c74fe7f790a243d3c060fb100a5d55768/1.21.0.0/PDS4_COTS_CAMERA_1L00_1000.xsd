     <xs:minInclusive value="-1.7976931348623157e308"/>
     <xs:maxInclusive value="1.7976931348623157e308"/>
	   </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="center_weighted_area_size">
    <xs:annotation>
      <xs:documentation>Defines the portion of the frame that the camera
